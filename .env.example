# ---------------------------------------------------------------------------
# IdeaProof AI — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All AI / API keys must be used ONLY in server-side API routes (api/),
# never exposed to the browser bundle.
# ---------------------------------------------------------------------------

# LLM provider (server-side only)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Supabase — browser-exposed public values (safe to ship to the client).
# Used by src/services/supabase.js. NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-only values (DO NOT expose to the browser / Vite).
# Used later in server-side API routes (api/). Never import into frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
VITE_APP_NAME=IdeaProof AI
# Public, non-secret runtime config only (VITE_ prefix is exposed to browser)
